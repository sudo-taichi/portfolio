---
import TableOfContents from "../components/TableOfContents.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  backHref: string;
  backLabel?: string;
  headings?: Heading[];
}

const {
  eyebrow,
  title,
  lead,
  backHref,
  backLabel = "一覧に戻る",
  headings = [],
} = Astro.props;
---

<main class="detail">
  <div class="detail-inner">
    <a class="back-link" href={backHref}>← {backLabel}</a>

    <header class="detail-header">
      <p class="eyebrow"><span class="prompt">#</span> {eyebrow}</p>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </header>

    <slot name="meta" />

    <TableOfContents headings={headings} />

    <div class="detail-body">
      <slot />
    </div>

    <a class="back-link back-link-bottom" href={backHref}>← {backLabel}</a>
  </div>
</main>

<style>
  .detail {
    padding: var(--space-6) var(--space-3) var(--space-7);
  }

  .detail-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link-bottom {
    margin-top: var(--space-6);
    margin-bottom: 0;
  }

  .detail-header {
    margin-bottom: var(--space-5);
    max-width: var(--prose-width);
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }

  .prompt {
    opacity: 0.7;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-fg);
    margin-bottom: var(--space-2);
  }

  .lead {
    color: var(--color-fg-muted);
    font-size: 1rem;
  }

  .detail-body {
    max-width: var(--prose-width);
  }

  /* 見出し階層を視覚的に区別 */
  .detail-body :global(h2) {
    font-size: 1.3rem;
    color: var(--color-fg);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-2);
    margin: var(--space-7) 0 var(--space-3);
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }

  .detail-body :global(h2:first-child) {
    margin-top: 0;
  }

  .detail-body :global(h3) {
    font-size: 1rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    margin: var(--space-5) 0 var(--space-2);
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }

  .detail-body :global(p) {
    margin: 0 0 var(--space-3);
    color: var(--color-fg-muted);
  }

  .detail-body :global(strong) {
    color: var(--color-fg);
  }

  .detail-body :global(ul) {
    margin: 0 0 var(--space-4);
    padding-left: 1.2rem;
    list-style: disc;
  }

  .detail-body :global(li) {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-2);
  }

  .detail-body :global(blockquote) {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-border);
    color: var(--color-fg-subtle);
  }

  .detail-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin: 0 0 var(--space-4);
    font-size: 0.9rem;
  }

  .detail-body :global(th),
  .detail-body :global(td) {
    text-align: left;
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    white-space: nowrap;
  }

  .detail-body :global(th) {
    color: var(--color-fg-subtle);
    font-weight: 400;
  }
</style>
