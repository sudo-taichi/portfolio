---
import BaseLayout from "../layouts/BaseLayout.astro";
import DetailLayout from "../layouts/DetailLayout.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("certifications", "index");
const { Content, headings } = await render(entry!);
const certList = entry!.data.certList;

const toc = [
  { depth: 2, slug: "保有資格", text: "保有資格" },
  ...headings,
];
---

<BaseLayout
  title="Certifications | Taichi Sudo"
  description="須藤大智の保有資格一覧と、AZ-305・AWS-SAA 取得までの学習アプローチ、後進育成への展開。"
>
  <DetailLayout
    eyebrow="Certifications"
    title="保有資格"
    backHref="/"
    backLabel="トップに戻る"
    headings={toc}
  >
    <section id="保有資格" class="cert-table-section">
      <h2>保有資格</h2>
      <table>
        <thead>
          <tr>
            <th>資格</th>
            <th>取得時期</th>
            <th>位置づけ</th>
          </tr>
        </thead>
        <tbody>
          {
            certList.map((cert) => (
              <tr>
                <td class:list={{ highlight: cert.highlight }}>
                  {cert.name}
                </td>
                <td>{cert.date}</td>
                <td class:list={{ highlight: cert.highlight }}>
                  {cert.tier}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <Content />
  </DetailLayout>
</BaseLayout>

<style>
  .cert-table-section table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin-bottom: var(--space-4);
  }

  .cert-table-section th,
  .cert-table-section td {
    text-align: left;
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    white-space: nowrap;
  }

  .cert-table-section th {
    color: var(--color-fg-subtle);
    font-weight: 400;
  }

  .cert-table-section td.highlight {
    color: var(--color-fg);
    font-weight: 700;
  }
</style>
