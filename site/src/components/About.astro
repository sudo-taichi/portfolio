---
import { getEntry, render } from "astro:content";
import Section from "./Section.astro";

const entry = await getEntry("about", "index");
const { Content } = await render(entry!);
---

<Section id="about" eyebrow="About" title="経歴">
  <div class="about-body">
    <Content />
  </div>
</Section>

<style>
  .about-body {
    max-width: 65ch;
  }

  .about-body :global(h2) {
    font-size: 1.1rem;
    color: var(--color-fg);
    margin: var(--space-5) 0 var(--space-2);
  }

  .about-body :global(h2:first-child) {
    margin-top: 0;
  }

  .about-body :global(p) {
    margin: 0 0 var(--space-3);
    color: var(--color-fg-muted);
  }

  .about-body :global(strong) {
    color: var(--color-fg);
  }

  .about-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 var(--space-3);
    font-size: 0.9rem;
  }

  .about-body :global(th),
  .about-body :global(td) {
    text-align: left;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-fg-muted);
  }

  .about-body :global(th) {
    color: var(--color-fg-subtle);
    font-weight: 400;
  }
</style>
