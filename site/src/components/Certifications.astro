---
import { getEntry } from "astro:content";
import Section from "./Section.astro";

const entry = await getEntry("certifications", "index");
const certList = entry!.data.certList;
---

<Section id="certifications" eyebrow="Certifications" title="保有資格">
  <div class="cert-body">
    <table>
      <thead>
        <tr>
          <th>資格</th>
          <th>取得時期</th>
          <th>位置づけ</th>
        </tr>
      </thead>
      <tbody>
        {
          certList.map((cert) => (
            <tr>
              <td class:list={{ highlight: cert.highlight }}>{cert.name}</td>
              <td>{cert.date}</td>
              <td class:list={{ highlight: cert.highlight }}>{cert.tier}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <a class="more-link" href="/certifications">詳細を見る →</a>
</Section>

<style>
  .cert-body {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  table {
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    text-align: left;
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    white-space: nowrap;
  }

  th {
    color: var(--color-fg-subtle);
    font-weight: 400;
  }

  td.highlight {
    color: var(--color-fg);
    font-weight: 700;
  }

  .more-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .more-link:hover {
    text-decoration: underline;
  }
</style>
