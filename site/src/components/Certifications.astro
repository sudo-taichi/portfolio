---
import { getEntry, render } from "astro:content";
import Section from "./Section.astro";

const entry = await getEntry("certifications", "index");
const { Content } = await render(entry!);
---

<Section id="certifications" eyebrow="Certifications" title="保有資格">
  <div class="cert-body">
    <Content />
  </div>
</Section>

<style>
  .cert-body {
    max-width: 65ch;
  }

  .cert-body :global(h2) {
    font-size: 1.1rem;
    color: var(--color-fg);
    margin: var(--space-5) 0 var(--space-2);
  }

  .cert-body :global(h2:first-child) {
    margin-top: 0;
  }

  .cert-body :global(h3) {
    font-size: 0.95rem;
    color: var(--color-fg);
    margin: var(--space-4) 0 var(--space-1);
  }

  .cert-body :global(p) {
    margin: 0 0 var(--space-3);
    color: var(--color-fg-muted);
  }

  .cert-body :global(strong) {
    color: var(--color-accent);
  }

  .cert-body :global(ul) {
    margin: 0 0 var(--space-3);
    padding-left: 1.1rem;
    list-style: disc;
  }

  .cert-body :global(li) {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-1);
  }

  .cert-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 var(--space-3);
    font-size: 0.9rem;
  }

  .cert-body :global(th),
  .cert-body :global(td) {
    text-align: left;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-fg-muted);
  }

  .cert-body :global(th) {
    color: var(--color-fg-subtle);
    font-weight: 400;
  }
</style>
