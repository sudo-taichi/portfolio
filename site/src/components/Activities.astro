---
import { getEntry, render } from "astro:content";
import Section from "./Section.astro";

const entry = await getEntry("activities", "index");
const { Content } = await render(entry!);
---

<Section id="activities" eyebrow="Activities" title="その他の取り組み">
  <div class="activity-body">
    <Content />
  </div>
</Section>

<style>
  .activity-body {
    max-width: 65ch;
  }

  .activity-body :global(h2) {
    font-size: 1.1rem;
    color: var(--color-fg);
    margin: var(--space-5) 0 var(--space-2);
  }

  .activity-body :global(h2:first-child) {
    margin-top: 0;
  }

  .activity-body :global(h3) {
    font-size: 0.95rem;
    color: var(--color-fg);
    margin: var(--space-4) 0 var(--space-1);
  }

  .activity-body :global(p) {
    margin: 0 0 var(--space-2);
    color: var(--color-fg-muted);
  }

  .activity-body :global(strong) {
    color: var(--color-accent);
  }

  .activity-body :global(ul) {
    margin: 0 0 var(--space-3);
    padding-left: 1.1rem;
    list-style: disc;
  }

  .activity-body :global(li) {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-1);
  }
</style>
