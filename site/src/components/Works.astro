---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

// 掲載順 = 技術的インパクト順（時系列順にしない）
const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="works" eyebrow="Works" title="実績">
  <ol class="works-list">
    {
      works.map((work) => (
        <li class="work-card">
          <div class="work-head">
            <span class="work-order">{String(work.data.order).padStart(2, "0")}</span>
            <div>
              <h3>{work.data.title}</h3>
              <p class="work-meta">
                {work.data.period}
                {work.data.role && ` ・ ${work.data.role}`}
              </p>
            </div>
          </div>

          <dl class="work-details">
            {work.data.challenge && (
              <>
                <dt>課題</dt>
                <dd>{work.data.challenge}</dd>
              </>
            )}
            <dt>打ち手</dt>
            <dd>{work.data.approach}</dd>
            <dt>成果</dt>
            <dd class:list={{ "is-todo": !work.data.result }}>
              {work.data.result || "TODO: 成果を追記"}
            </dd>
          </dl>

          {work.data.tech.length > 0 && (
            <ul class="work-tech">
              {work.data.tech.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}

          {work.data.note && <p class="work-note">※ {work.data.note}</p>}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .works-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .work-card {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
  }

  .work-head {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .work-order {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 1.25rem;
  }

  .work-card h3 {
    color: var(--color-fg);
    font-size: 1.15rem;
    margin-bottom: var(--space-1);
  }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .work-details {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-1) var(--space-3);
    margin: 0 0 var(--space-3);
  }

  .work-details dt {
    color: var(--color-fg-subtle);
    font-size: 0.85rem;
  }

  .work-details dd {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: 0.92rem;
  }

  .work-details dd.is-todo {
    color: var(--color-fg-subtle);
    font-style: italic;
  }

  .work-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .work-tech li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 999px;
    color: var(--color-accent);
  }

  .work-note {
    font-size: 0.8rem;
    color: var(--color-fg-subtle);
  }

  @media (max-width: 40rem) {
    .work-details {
      grid-template-columns: 1fr;
    }

    .work-details dt {
      margin-top: var(--space-2);
    }
  }
</style>
