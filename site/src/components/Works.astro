---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

// 掲載順 = 技術的インパクト順（時系列順にしない）
const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="works" eyebrow="Works" title="実績">
  <ol class="works-list">
    {
      works.map((work) => (
        <li class:list={["work-card", { "is-featured": work.data.featured }]}>
          <a class="work-card-link" href={`/works/${work.id}`}>
            <div class="work-head">
              <span class="work-order">
                {String(work.data.order).padStart(2, "0")}
              </span>
              <div>
                <h3>{work.data.title}</h3>
                <p class="work-meta">
                  {work.data.period}
                  {work.data.role && ` ・ ${work.data.role}`}
                  {work.data.teamSize && `（チーム${work.data.teamSize}名）`}
                </p>
              </div>
            </div>

            <p class="work-excerpt">{work.data.summary}</p>

            {work.data.stack.length > 0 && (
              <ul class="work-tech">
                {work.data.stack.slice(0, 5).map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}

            <span class="work-more">詳細を見る →</span>
          </a>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .works-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .work-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    transition: border-color 0.15s ease;
  }

  .work-card:hover {
    border-color: var(--color-accent-border);
  }

  .work-card.is-featured {
    border-color: var(--color-accent-border);
  }

  .work-card-link {
    display: block;
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
  }

  .work-head {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .work-order {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 1.25rem;
  }

  .work-card h3 {
    color: var(--color-fg);
    font-size: 1.15rem;
    margin-bottom: var(--space-1);
  }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .work-excerpt {
    margin: 0 0 var(--space-3);
    color: var(--color-fg-muted);
    font-size: 0.92rem;
    max-width: var(--prose-width);
  }

  .work-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .work-tech li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 999px;
    color: var(--color-accent);
  }

  .work-more {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
  }
</style>
