---
import { getCollection, render } from "astro:content";
import Section from "./Section.astro";

const entries = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order,
);

const cards = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);
---

<Section id="skills" eyebrow="Skills" title="スキル">
  <div class="skill-grid">
    {
      cards.map(({ entry, Content }) => (
        <article class="skill-card">
          <p class="skill-category">{entry.data.categoryLabel}</p>
          <h3>{entry.data.title}</h3>
          <div class="skill-body">
            <Content />
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .skill-card {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
  }

  .skill-category {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    margin-bottom: var(--space-1);
  }

  .skill-card h3 {
    color: var(--color-fg);
    font-size: 1.05rem;
    margin-bottom: var(--space-2);
  }

  .skill-body :global(h3) {
    font-size: 0.92rem;
    color: var(--color-fg);
    margin: var(--space-3) 0 var(--space-1);
  }

  .skill-body :global(h3:first-child) {
    margin-top: 0;
  }

  .skill-body :global(p) {
    font-size: 0.9rem;
    margin: 0 0 var(--space-2);
    color: var(--color-fg-muted);
  }

  .skill-body :global(strong) {
    color: var(--color-fg);
  }

  .skill-body :global(ul) {
    margin: 0 0 var(--space-2);
    padding-left: 1.1rem;
    list-style: disc;
  }

  .skill-body :global(li) {
    font-size: 0.9rem;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-1);
  }

  .skill-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 var(--space-2);
    font-size: 0.85rem;
  }

  .skill-body :global(th),
  .skill-body :global(td) {
    text-align: left;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-fg-muted);
  }

  .skill-body :global(th) {
    color: var(--color-fg-subtle);
    font-weight: 400;
  }

  @media (max-width: 40rem) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
