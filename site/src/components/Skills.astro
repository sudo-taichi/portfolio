---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

const entries = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="skills" eyebrow="Skills" title="スキル">
  <div class="skill-grid">
    {
      entries.map((entry) => (
        <article class="skill-card">
          <p class="skill-category">{entry.data.categoryLabel}</p>
          <h3>{entry.data.title}</h3>
          <p class="skill-summary">{entry.data.summary}</p>
        </article>
      ))
    }
  </div>
  <a class="more-link" href="/skills">Skills の詳細を見る →</a>
</Section>

<style>
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .skill-card {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
  }

  .skill-category {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    margin-bottom: var(--space-1);
  }

  .skill-card h3 {
    color: var(--color-fg);
    font-size: 1.05rem;
    margin-bottom: var(--space-2);
  }

  .skill-summary {
    font-size: 0.9rem;
    color: var(--color-fg-muted);
    margin: 0;
  }

  .more-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .more-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
